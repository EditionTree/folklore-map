__pycache__/
*.py[cod]
.env
.env.*
legends.*-review.json
legends.review.json
source_snapshots/

# Scratch / working files — one-off session output, review drafts, contact
# sheets. Never intended to be committed; if you're writing a throwaway
# script or note, prefix the filename with _tmp_ so it's caught here too.
_tmp_*
tmp/
output/

# Monthly "recent sightings" research worksheets — same category as the
# *-review.xlsx files below (a personal review draft, not published content;
# see sightings.json for what's actually live).
sighting-research/

# On-hold PDF field-guide build pipeline. Kept on disk locally (don't want
# to redo the font/asset setup if it's picked back up) but not tracked —
# it's build tooling + generated output, not site content.
_fieldguide_build/

# Operational logs and local config — not needed for the live site
bug_reports/
.claude/
_drafts/

# Search Console pipe — secret credentials + local-only output
gsc-service-account.json
gsc-oauth-client.json
gsc-token.json
search-insights/

# Local curation worksheets — personal guides for directing collection /
# achievement creation, not site content. Never committed.
*-review.xlsx

# Ornament art masters (*-source.png) + unused generated variants — kept
# locally but never deployed. Only oak-branch-frame-v1.png is used as a PNG
# (the other live ornaments are WebP), so ignore every other PNG in the dir.
assets/ornaments/generated-variants/*.png
!assets/ornaments/generated-variants/oak-branch-frame-v1.png

# Font cache for scripts/build_og_card.py (re-downloaded on demand)
tmp/ogfonts/

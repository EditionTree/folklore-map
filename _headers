# script-src no longer allows 'unsafe-inline'. An injected <script>, and any
# inline on*= handler however it was created, is now refused. Getting here meant
# moving ~148KB of inline JavaScript into js/, converting 21 inline handlers to
# listeners, and changing generate_pages.py to pass per-page parameters as data
# attributes instead of baking them into a script (which gave every page a
# different hash and made this impossible).
#
# The six hashes cover every inline script left on the site. A CSP hash is over
# the exact bytes between <script> and </script>, so EDITING ANY OF THESE
# SCRIPTS SILENTLY STOPS IT EXECUTING until the hash here is regenerated:
#   scripts/csp_hashes.py prints the current set.
#
#   'sha256-je32InupW6z1LvhPlzaoNMPULTcSyEX+A53xk1Utuqk='
#       pages.dev redirect, 818 pages
#   'sha256-l74Ue0CxVi/w2SX/tGJ/yRrGD2jSM3ycndYxNn04V9w='
#       Turnstile bootstrap, map.html
#   'sha256-wlT/Z6Mwjo5izSV5wAhhpAZ682HhwzZzSZlUE+L6vyA='
#       Turnstile bootstrap, updates.html
#   'sha256-OTrxtcoXO0a1ELE+iYU9ccQDozhpP/fkXb0MALPceo8='
#       orphan legends-of-the-sea-4, track
#   'sha256-H48IT9HzD1IT0hL547p97YTQbHh0uQemGmQOV0h3gaw='
#       orphan legends-of-the-sea-4, progress
#   'sha256-m9+BjjysbWVGHHXVZak/lcXCKz7O88ulQQ5m4GAtFCU='
#       name-tool, unlinked
#
# Two of them are dormant pages that no longer belong to the build:
# legends/collection/legends-of-the-sea-4.html is no longer generated (the
# collection lost its fourth page, as -5 and -6 already did and which _redirects
# already handles), and name-tool/ is unlinked and absent from the sitemap.
# Both are still served, so they are hashed rather than left to break. Deleting
# them, with redirects, would remove three of these six hashes.
#
# style-src keeps 'unsafe-inline' deliberately: map.html alone carries 36KB of
# <style> plus 18 style= attributes. Separate, larger job.
#
# CSP connect-src is pinned to the exact Supabase project host, not
# *.supabase.co -- the wildcard would let injected script exfiltrate to any
# Supabase project, and anyone can create one for free.
#
# cloudflareinsights.com is listed because the Web Analytics beacon posts to
# https://cloudflareinsights.com/cdn-cgi/rum when the same-origin /cdn-cgi/rum
# path is unavailable. It was absent before, so that fallback would have been
# blocked silently. There is no CSP reporting configured yet, so a block like
# that produces no signal at all -- see the roadmap's Stage 2 CSP work.
#
# form-action 'self': no page on the site has a form with an action attribute
# (every form posts via fetch, which connect-src governs), so this costs
# nothing and stops an injected form from exfiltrating on submit.
#
# CSP violations are reported to the csp-report edge function. Both mechanisms
# are declared because browsers disagree: report-uri is the legacy one Firefox
# still uses, report-to plus the Reporting-Endpoints header is what Chrome
# prefers. The function understands both wire formats.
#
# Reports are aggregated by fingerprint rather than appended, and browser
# extension schemes are dropped before storage -- on any public site those are
# the overwhelming majority of reports and none of them say anything about this
# one. document-uri is reduced to its path and blocked-uri to its origin, so a
# violation report never becomes a record of what someone searched for.
#
# Until this existed there was no way to tell a working directive from one
# silently blocking something, which is why the connect-src question earlier in
# Stage 1 had to be answered by reading beacon source rather than by evidence.
#
# Permissions-Policy: geolocation must be (self), NOT (). An empty allowlist
# disables the Geolocation API outright, so "Find folklore near me" -- the
# homepage's primary call to action -- could never work: no permission prompt
# ever appeared, and the error branch reported "Location access was declined",
# blaming the visitor for a refusal they never made. Coordinates still never
# leave the browser; the browser's own permission prompt is the real control.
# camera/microphone stay fully disabled, the site uses neither.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  Reporting-Endpoints: csp-endpoint="https://canjzkpvjwvkbjcduaaj.supabase.co/functions/v1/csp-report"
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-je32InupW6z1LvhPlzaoNMPULTcSyEX+A53xk1Utuqk=' 'sha256-l74Ue0CxVi/w2SX/tGJ/yRrGD2jSM3ycndYxNn04V9w=' 'sha256-wlT/Z6Mwjo5izSV5wAhhpAZ682HhwzZzSZlUE+L6vyA=' 'sha256-OTrxtcoXO0a1ELE+iYU9ccQDozhpP/fkXb0MALPceo8=' 'sha256-H48IT9HzD1IT0hL547p97YTQbHh0uQemGmQOV0h3gaw=' 'sha256-m9+BjjysbWVGHHXVZak/lcXCKz7O88ulQQ5m4GAtFCU=' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org https://*.stamen.com https://*.stadiamaps.com https://stamen-tiles.a.ssl.fastly.net https://*.basemaps.cartocdn.com blob:; connect-src 'self' https://canjzkpvjwvkbjcduaaj.supabase.co https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src blob:; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; report-uri https://canjzkpvjwvkbjcduaaj.supabase.co/functions/v1/csp-report; report-to csp-endpoint;

# Versioned/static assets (ornaments carry ?v= cache-busters, achievement art is stable) — cache hard
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# achievements.json is hand-edited DATA, not art — the immutable /assets/* rule
# above would freeze edits in returning visitors' browsers for a year. Keep it
# short-lived so hand-edits actually reach people. (More specific path, declared
# after the broad rule, so it wins the Cache-Control conflict.)
/assets/achievements/achievements.json
  Cache-Control: public, max-age=300, must-revalidate

# Site data JSON. These are re-generated by the daily pipeline, so they must not
# be immutable, but they were previously fetched with ?v=Date.now(), which made
# every request a unique URL. The browser keys its cache by full URL, so it never
# held an entry, never sent If-None-Match, and always took a full 200: roughly
# 489KB of legend_pages.json on every single map load, and 2.1MB of legends.json
# whenever the Supabase fallback ran.
#
# The cache-busters are gone. Cloudflare already serves ETags on these, so a
# repeat visit now revalidates and gets a 304 with an empty body. max-age=300
# additionally skips the revalidation round trip within five minutes, which is
# what someone going map -> legend -> back to map actually experiences. Five
# minutes of staleness on a daily-updated folklore dataset costs nothing.
/legends.json
  Cache-Control: public, max-age=300, must-revalidate
/legend_pages.json
  Cache-Control: public, max-age=300, must-revalidate
/legends-index.json
  Cache-Control: public, max-age=300, must-revalidate
/collections.json
  Cache-Control: public, max-age=300, must-revalidate
/uk-places.json
  Cache-Control: public, max-age=300, must-revalidate

# Extracted page scripts. Deliberately NOT immutable, even though they carry a
# ?v= query: the stylesheets already demonstrate that trap, where an un-bumped
# version ships nothing for a year. Four hours matches what Cloudflare already
# serves for the root scripts (nav-search.js, legend-page.js, share-card.js),
# so behaviour stays consistent across every script on the site.
/js/*
  Cache-Control: public, max-age=14400, must-revalidate

# Fonts, once self-hosted, are immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Legend hero art can be re-generated under the same name, so cache long but not immutable
/legend-images/*
  Cache-Control: public, max-age=2592000
